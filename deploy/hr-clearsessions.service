[Unit]
Description=Clear expired Practice HR sessions

[Service]
Type=oneshot
# The same user, directories and sandbox as the web service; see
# gunicorn.service for why each is there.
User=practice-hr
Group=practice-hr
WorkingDirectory=/srv/practice-hr
StateDirectory=practice-hr
StateDirectoryMode=0700
ReadWritePaths=/var/lib/practice-hr
UMask=0077
# SECRET_KEY lives in the environment file; manage.py refuses to start
# without it. See gunicorn.service for why the file is root-only.
EnvironmentFile=/etc/practice-hr.env
ExecStart=/srv/practice-hr/.venv/bin/python manage.py clearsessions

# Sandbox: identical in every practice-hr unit (tests/test_deploy.py).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
