[Unit]
Description=Clear expired Practice HR sessions

[Service]
Type=oneshot
WorkingDirectory=/root/practice-hr
# SECRET_KEY lives in the environment file; manage.py refuses to start
# without it. See gunicorn.service for why the file is root-only.
EnvironmentFile=/etc/practice-hr.env
ExecStart=/root/practice-hr/.venv/bin/python manage.py clearsessions
