[Unit]
Description=Practice HR gunicorn
After=network.target

[Service]
# The app runs as its own unprivileged user, never root. A bug that let a
# request run code would otherwise hand over the whole container. As the
# practice-hr user it can reach the app's own data and nothing else.
#
#   useradd --system --home-dir /srv/practice-hr --no-create-home \
#           --shell /usr/sbin/nologin practice-hr
User=practice-hr
Group=practice-hr

WorkingDirectory=/srv/practice-hr

# Unlike the rota, this app's database sits inside its own code directory —
# config/settings.py has no separate DB_PATH setting to move it out — so
# the whole tree is owned by the practice-hr user (above) rather than split
# between a root-owned code directory and a writable state directory. That
# is a real trade-off, not a free adaptation: a code-execution bug here can
# rewrite the app's own files, not only its data, because nothing marks the
# code itself read-only to the user running it. ReadWritePaths lifts
# ProtectSystem=strict's read-only mount for this one path; ownership is
# what keeps the app from touching anything outside it.
ReadWritePaths=/srv/practice-hr
UMask=0077

# Secrets go in an environment file, not in Environment= lines. Unit files
# under /etc/systemd/system are world-readable by default, so a SECRET_KEY
# written here is readable by every local account — and with that key an
# attacker can forge a session cookie for any user, including an HR admin.
# systemd reads the file as root before it drops to the practice-hr user,
# so it stays root-only. Create it once:
#
#   umask 077
#   /srv/practice-hr/.venv/bin/python -c \
#     'from django.core.management.utils import get_random_secret_key as k; \
#      print("SECRET_KEY=" + k())' > /etc/practice-hr.env
#   chmod 600 /etc/practice-hr.env
#
# and add the rest of the settings to it:
#
#   DEBUG=0
#   ALLOWED_HOSTS=hr.example.org
#   CSRF_TRUSTED_ORIGINS=https://hr.example.org
#   OIDC_RSA_PRIVATE_KEY=…  # one line, \n for newlines; generate with openssl genrsa 2048
#
# DEBUG defaults to 0 in config/settings.py, so omitting it is safe — but set
# it explicitly so the file states the intent.
EnvironmentFile=/etc/practice-hr.env

# Bound to loopback on purpose: the Cloudflare tunnel is the only way in.
# settings.py trusts X-Forwarded-Proto to decide a request is HTTPS, which is
# only sound while nothing can reach gunicorn directly and set that header
# itself. Do not change this to 0.0.0.0.
ExecStart=/srv/practice-hr/.venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8322 --workers 2
Restart=always

# The sandbox. Everything outside /srv/practice-hr is read-only, /home and
# /root are hidden, /tmp is private, and the process can gain no privileges
# or capabilities, load no kernel modules, change no kernel settings, and
# open no sockets but IP and Unix ones. The same block is in every
# practice-hr unit; `systemd-analyze security practice-hr` scores it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
