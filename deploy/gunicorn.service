[Unit]
Description=Practice HR gunicorn
After=network.target

[Service]
# The app runs as its own unprivileged user, never root. A bug that let a
# request run code would otherwise hand over the whole container, including
# cloudflared's tunnel credentials, which would let an attacker sit in the
# middle of every user's session. As the practice-hr user it can reach the
# app's own data and nothing else.
#
#   useradd --system --home-dir /var/lib/practice-hr --no-create-home \
#           --shell /usr/sbin/nologin practice-hr
User=practice-hr
Group=practice-hr

# The code lives in /srv/practice-hr, owned by root and read-only to the
# practice-hr user, so the app cannot rewrite itself. Its data lives in
# /var/lib/practice-hr: systemd creates that as StateDirectory, owned by
# practice-hr and closed to everyone else, and DB_PATH in
# /etc/practice-hr.env points the database there (and MEDIA_ROOT the payroll
# reports, in a directory beneath it). SQLite needs to write the
# directory its database sits in, which is why the two are apart.
WorkingDirectory=/srv/practice-hr
StateDirectory=practice-hr
StateDirectoryMode=0700
# StateDirectory already implies write access to /var/lib/practice-hr under
# ProtectSystem=strict; naming it here too makes the one writable path
# explicit rather than an implicit side effect of the line above.
ReadWritePaths=/var/lib/practice-hr
UMask=0077

# Secrets go in an environment file, not in Environment= lines. Unit files
# under /etc/systemd/system are world-readable by default, so a SECRET_KEY
# written here is readable by every local account — and with that key an
# attacker can forge a session cookie for any user, including an HR admin.
# systemd reads the file as root before it drops to the practice-hr user,
# so it stays root-only. Create it once:
#
#   umask 077
#   /srv/practice-hr/.venv/bin/python -c \
#     'from django.core.management.utils import get_random_secret_key as k; \
#      print("SECRET_KEY=" + k())' > /etc/practice-hr.env
#   chmod 600 /etc/practice-hr.env
#
# and add the rest of the settings to it:
#
#   DEBUG=0
#   DB_PATH=/var/lib/practice-hr/db.sqlite3
#   MEDIA_ROOT=/var/lib/practice-hr/media
#   ALLOWED_HOSTS=hr.example.org
#   CSRF_TRUSTED_ORIGINS=https://hr.example.org
#   OIDC_RSA_PRIVATE_KEY_FILE=/etc/practice-hr/oidc.pem
#
# The OIDC signing key is a file of its own, never a line in this file:
# systemd's environment-file parser turns an unquoted \n into a plain "n",
# so a PEM key folded onto one line arrives broken. The app reads the file
# itself, as the practice-hr user, so it is root:practice-hr, mode 640, in
# a directory of the same (README, Deploy):
#
#   install -d -o root -g practice-hr -m 750 /etc/practice-hr
#   (umask 027; openssl genrsa -out /etc/practice-hr/oidc.pem 2048)
#   chgrp practice-hr /etc/practice-hr/oidc.pem
#
# DEBUG defaults to 0 in config/settings.py, so omitting it is safe — but set
# it explicitly so the file states the intent.
EnvironmentFile=/etc/practice-hr.env

# Bound to loopback on purpose: the Cloudflare tunnel is the only way in.
# settings.py trusts X-Forwarded-Proto to decide a request is HTTPS, which is
# only sound while nothing can reach gunicorn directly and set that header
# itself. Do not change this to 0.0.0.0.
ExecStart=/srv/practice-hr/.venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8322 --workers 2
Restart=always

# The sandbox. Everything outside /var/lib/practice-hr is read-only, /home
# and /root are hidden, /tmp is private, and the process can gain no
# privileges or capabilities, load no kernel modules, change no kernel
# settings, and open no sockets but IP and Unix ones. The same block is in
# every practice-hr unit; `systemd-analyze security practice-hr` scores it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
