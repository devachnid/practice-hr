[Unit]
Description=Nightly Practice HR SQLite backup

[Service]
Type=oneshot
# As the practice-hr user, not root. The copies are the app's own data, so
# they belong with it in /var/lib/practice-hr, closed to everyone else; and
# a root sqlite3 opening a WAL database can leave -wal/-shm files the app
# cannot then open. The same user, directories and sandbox as the web
# service; see gunicorn.service for why each is there.
User=practice-hr
Group=practice-hr
StateDirectory=practice-hr
StateDirectoryMode=0700
ReadWritePaths=/var/lib/practice-hr
UMask=0077
ExecStart=/srv/practice-hr/deploy/backup.sh

# Sandbox: identical in every practice-hr unit (tests/test_deploy.py).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
