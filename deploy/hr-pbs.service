[Unit]
Description=Push Practice HR's nightly backup to the Proxmox Backup Server
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
# As the practice-hr user, like the backup it follows: the copies are
# readable by nobody else. The PBS address and certificate fingerprint are
# in /etc/pbs-backup/practice-hr.env. The API token and the encryption key
# are credentials (root-owned files, handed to this unit only), kept out of
# the environment because a process's environment is readable by every
# other process running as practice-hr, the web service included. See the
# README's "Off-site backup" section.
User=practice-hr
Group=practice-hr
StateDirectory=practice-hr
StateDirectoryMode=0700
ReadWritePaths=/var/lib/practice-hr
UMask=0077
EnvironmentFile=/etc/pbs-backup/practice-hr.env
LoadCredential=pbs.token:/etc/pbs-backup/practice-hr.token
LoadCredential=pbs.key:/etc/pbs-backup/practice-hr.key
ExecStart=/srv/practice-hr/deploy/pbs-push.sh

# Sandbox: identical in every practice-hr unit (tests/test_deploy.py).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
